# Python
__pycache__/
*.pyc

# Virtual environments
venv/
.venv/

# Datasets (large binary data, not code)
hycom_numpy/
hycom_dataset/

# Original reference implementations, superseded by models/SoFoNO/ and
# models/SRNO/. Kept locally for reference; Super-Resolution-Neural-Operator/
# is already version-controlled separately at github.com/vinicius-rabello/srno.
# (Leading slash anchors these to the repo root only -- otherwise they'd also
# match models/SoFoNO/, which we do want tracked.)
/SoFoNO/
/Super-Resolution-Neural-Operator/

# Training outputs: checkpoints and sample images (large, reproducible via train.py)
models/**/output/weights/
models/**/output/images/

# Notebooks
.ipynb_checkpoints/

# OS / editor cruft
.DS_Store

# Images
*.png
*.jpg
*.jpeg

# Logs
/logs/
# New run layout: keep config/summary/logs, not checkpoints or images
results/**/*.pt
results/**/*.tmp
results/**/images/
# Pilot and short measurements: same rule as results/
results_pilot/**/*.pt
results_pilot/**/*.tmp
results_pilot/**/images/
results_pilot/**/*.npz
results_pilot/*.zip
